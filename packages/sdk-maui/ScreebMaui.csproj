<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-ios</TargetFrameworks>
    <RootNamespace>Screeb.Maui</RootNamespace>
    <AssemblyName>Screeb.Maui</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SingleProject>true</SingleProject>
    <!-- NuGet metadata -->
    <PackageId>Screeb.Maui</PackageId>
    <Version>0.1.0</Version>
    <Authors>Screeb</Authors>
    <Company>Screeb</Company>
    <Description>Screeb Continuous Product Discovery SDK for .NET MAUI (Android + iOS)</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://developers.screeb.app/sdk-maui/install</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ScreebApp/sdk</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>maui android ios screeb survey analytics</PackageTags>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Android native binding -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <AndroidMavenLibrary
      Include="app.screeb.sdk:survey"
      Version="3.2.0"
      Bind="true" />
  </ItemGroup>

  <!-- iOS native binding -->
  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
    <NativeReference Include="native/ios/Screeb.xcframework">
      <Kind>Framework</Kind>
      <Frameworks>Foundation UIKit</Frameworks>
      <IsCxx>false</IsCxx>
    </NativeReference>
    <Compile Include="Platforms/iOS/ApiDefinitions.cs" />
    <Compile Include="Platforms/iOS/StructsAndEnums.cs" />
  </ItemGroup>

  <!-- NuGet: include README and native iOS framework -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Content Include="native/ios/Screeb.xcframework/**"
             Pack="true"
             PackagePath="runtimes/ios/native/" />
  </ItemGroup>
</Project>
