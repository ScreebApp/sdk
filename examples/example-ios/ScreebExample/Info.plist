<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Screeb deep links: scheme is screeb-<channelId> (same convention as
	     example-android's manifest). Merged with the Xcode-generated Info.plist
	     (GENERATE_INFOPLIST_FILE stays on for everything else). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.screeb.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>screeb-0e2b609a-8dce-4695-a80f-966fbfa87a88</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
