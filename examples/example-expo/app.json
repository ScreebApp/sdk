{
  "expo": {
    "name": "example-expo",
    "slug": "example-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "exampleexpo",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.example-expo"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.exampleexpo"
    },
    "plugins": [
      "./plugins/withScreebLocalSdk",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
