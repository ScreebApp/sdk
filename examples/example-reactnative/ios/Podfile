ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ScreebReactNativeExample' do
  config = use_native_modules!

  if ENV["SCREEB_USE_LOCAL_SDK"] == "true"
    screeb_ios_sdk_path = ENV["SCREEB_IOS_SDK_PATH"] || File.expand_path("../../../../sdk-ios", __dir__)
    pod "Screeb", :path => screeb_ios_sdk_path
  end

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Local perf/debug logging for the Screeb pod (compiled out of published
    # pods). Enable with SCREEB_TELEMETRY=true alongside SCREEB_USE_LOCAL_SDK=true.
    installer.pods_project.targets.each do |target|
      next unless target.name == "Screeb" && ENV["SCREEB_TELEMETRY"] == "true"

      target.build_configurations.each do |config|
        conditions = config.build_settings["SWIFT_ACTIVE_COMPILATION_CONDITIONS"] || "$(inherited)"
        config.build_settings["SWIFT_ACTIVE_COMPILATION_CONDITIONS"] = "#{conditions} SCREEB_TELEMETRY"
      end
    end

    # Xcode 26 can compile React Native's fmt 11 pod with consteval enabled,
    # then fail in fmt's own constant-expression checks. Keep C++20 for RN,
    # but disable fmt consteval only for that pod.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'

      target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FMT_USE_CONSTEVAL=0'
      end
    end

    fmt_base_header = File.join(installer.sandbox.root, 'fmt/include/fmt/base.h')
    if File.exist?(fmt_base_header)
      base_h = File.read(fmt_base_header)
      patched_base_h = base_h
        .gsub("#elif defined(__cpp_consteval)\n#  define FMT_USE_CONSTEVAL 1", "#elif defined(__cpp_consteval)\n#  define FMT_USE_CONSTEVAL 0")
        .gsub("#elif FMT_GCC_VERSION >= 1002 || FMT_CLANG_VERSION >= 1101\n#  define FMT_USE_CONSTEVAL 1", "#elif FMT_GCC_VERSION >= 1002 || FMT_CLANG_VERSION >= 1101\n#  define FMT_USE_CONSTEVAL 0")

      if patched_base_h != base_h
        File.chmod(0644, fmt_base_header)
        File.write(fmt_base_header, patched_base_h)
      end
    end
  end
end
